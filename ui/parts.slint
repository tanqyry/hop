import { Theme } from "theme.slint";

export struct EntryRow { name: string, dir: bool, size: string, date: string, kind: string, selected: bool, hidden: bool, cut: bool, renaming: bool, thumb: image, has-thumb: bool }
export struct TileItem { name: string, dir: bool, size: string, ext: string, selected: bool, hidden: bool, cut: bool, renaming: bool, thumb: image, has-thumb: bool }
export struct TileRow { items: [TileItem] }
export struct InfoRow { k: string, v: string }
export struct TabRow { title: string, dirty: bool, edit: bool, active: bool }
export struct SideRow { label: string, sub: string, path: string, kind: int, active: bool, meter: float }   // kind: 0 header, 1 pin, 2 alias, 3 drive
export struct Run { text: string, kind: int }                                                            // 0 base, 1 matched, 2 via, 3 lone folder
export struct CandRow { runs: [Run], note: string, selected: bool, bad: bool }
export struct EdLine { tint: int, number: string, runs: [Run], current: bool, sel-a: int, sel-n: int, match-a: int, match-n: int }
export struct TraceRow { tok: string, name: string, note: string, warn: bool }

// ---- icons: drawn as paths so they follow the theme colour ----
export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.fg2;
    in property <bool> filled: false;
    width: 16px; height: 16px;
    viewbox-width: 16; viewbox-height: 16;
    commands: root.d;
    stroke: root.filled ? transparent : root.tint;
    stroke-width: 1.5px;
    fill: root.filled ? root.tint : transparent;
}

export component IconButton inherits Rectangle {
    in property <string> d;
    in property <bool> enabled: true;
    in property <bool> on: false;
    callback clicked;
    width: 32px; height: 32px;
    border-radius: Theme.r1;
    background: root.on ? Theme.sel : (ta.has-hover && root.enabled ? Theme.hov : transparent);
    animate background { duration: Theme.t-fast; }
    Icon { d: root.d; tint: !root.enabled ? Theme.fg3 : (ta.has-hover || root.on ? Theme.fg : Theme.fg2); }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component FolderGlyph inherits Path {
    in property <color> tint: Theme.fg2;
    width: 16px; height: 16px;
    viewbox-width: 16; viewbox-height: 16;
    commands: "M1.5 4.25 A1.75 1.75 0 0 1 3.25 2.5 L6.15 2.5 C6.61 2.5 7.05 2.68 7.38 3 L8.28 3.9 C8.43 4.05 8.63 4.13 8.84 4.13 L13 4.13 A1.75 1.75 0 0 1 14.75 5.88 L14.75 12.25 A1.75 1.75 0 0 1 13 14 L3.25 14 A1.75 1.75 0 0 1 1.5 12.25 Z";
    fill: root.tint;
}

export component FileGlyph inherits Path {
    in property <color> tint: Theme.fg3;
    width: 16px; height: 16px;
    viewbox-width: 16; viewbox-height: 16;
    commands: "M4.5 2 L9.3 2 L12.5 5.2 L12.5 13.5 L4 13.5 L4 2.5 Z M9 2 L9 5.5 L12.5 5.5";
    stroke: root.tint; stroke-width: 1.2px; fill: transparent;
}

// small segmented control
export component Seg inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback picked(int);
    height: 28px;
    HorizontalLayout {
        spacing: 2px;
        for l[i] in root.labels: Rectangle {
            border-radius: Theme.r1;
            background: i == root.current ? Theme.sel : (t.has-hover ? Theme.hov : transparent);
            Text { text: l; color: i == root.current ? Theme.fg : Theme.fg2; horizontal-alignment: center; vertical-alignment: center; }
            t := TouchArea { clicked => { root.picked(i); } }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 34px; height: 20px; border-radius: 10px;
    background: root.on ? Theme.acc : Theme.sel2;
    animate background { duration: Theme.t-fast; }
    Rectangle {
        y: 2px; width: 16px; height: 16px; border-radius: 8px; background: Theme.fg;
        x: root.on ? 16px : 2px;
        animate x { duration: Theme.t; easing: ease-out; }
    }
    TouchArea { clicked => { root.toggled(); } }
}

export component CtxItem inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    height: 30px; border-radius: Theme.r2;
    background: ta.has-hover && root.enabled ? Theme.hov : transparent;
    Text { x: 12px; text: root.label; color: root.enabled ? Theme.fg : Theme.fg3; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
export component CtxSep inherits Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: Theme.line; } }
